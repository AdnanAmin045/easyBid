# Freelancer access token (developers.freelancer.com)
FREELANCER_TOKEN=

# AI that picks projects and writes proposals. Set the key for the models chosen in Settings.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# More Gemini keys (each from a different Google account or Cloud project, or they share one quota).
# Key 1 tries every Gemini model, cheapest to best, before key 2 starts; then key 3, and so on.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional free-tier providers. Add their models as fallbacks in Settings > AI;
# when one model is out of quota the next one in the list writes instead.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Supabase: Connect > Connection string > Session pooler (URI), with your database password filled in
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Upstash Redis for the arq worker: Upstash console > your database > Connect > TCP, the rediss:// URL.
# Only the worker process uses it (arq app.worker.WorkerSettings).
REDIS_URL=
# true (the default): poll inside the web process, no worker and no Redis needed.
# false: the arq worker polls, and the web process only takes over if the worker stops reporting in.
EMBEDDED_SCHEDULER=true

# Jobs service: Gmail OAuth client (Google Cloud > APIs & Services > Credentials > OAuth client ID, type Web application).
# GOOGLE_REDIRECT_URI must be registered on that client exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/jobs/gmail/callback
# Dashboard URL to return to after connecting Gmail. Empty: the first CORS origin.
APP_URL=

# Dashboard login
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
